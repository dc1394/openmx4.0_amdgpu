integer(4),intent(in)::global_row
integer(4),intent(in)::nblk
integer(4),intent(in)::np_rows
integer(4)::local_row
end
function map_global_array_index_to_local_index(iglobal,jglobal,ilocal,jlocal,nblk,np_rows,np_cols,my_prow,my_pcol) result(possible)
integer(4),intent(in)::iglobal
integer(4),intent(in)::jglobal
